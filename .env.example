# Bearer API keys. Never commit the real .env file.
# allow_models: list of logical model names, or ["*"] for all configured models.
GATEWAY_API_KEYS=[{"id":"local-dev","key":"sk-local-dev","allow_models":["fast","general"]},{"id":"fast-only","key":"sk-fast-only","allow_models":["fast"]}]

# Optional override of config/models.yaml backends.ollama.base_url
# Docker Compose uses host networking and this loopback URL so Ollama
# can stay bound to 127.0.0.1 (not published on the LAN).
OLLAMA_BASE_URL=http://127.0.0.1:11434
